# Local-only values. Replace all of these before deployment.
# Email messages stay queued until SMTP_HOST, SMTP_USERNAME, and SMTP_PASSWORD are configured.
SA_PASSWORD=LocalOnly_StrongPassword_ChangeMe_123!
JWT_KEY=local-only-signing-key-change-this-to-32-bytes-minimum-2026
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=LocalOnly_Admin_ChangeMe_123!
AGENT_EMAIL=agent@helpdesk.local
AGENT_PASSWORD=LocalOnly_Agent_ChangeMe_123!
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@helpdesk.local
SMTP_FROM_NAME=OrbitDesk
